<mxfile host="Electron">
  <diagram name="Page-1" id="8mTaMK5F745M0YtbXuQg">
    <mxGraphModel dx="2146" dy="1304" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml PathSG_Design_Class_Diagram\nskinparam classAttributeIconSize 0\nskinparam classFontSize 11\nskinparam linetype ortho\nhide empty members\n\npackage \&quot;Presentation Layer (Vue SPA)\&quot; {\n\n  class ClientBootstrap &lt;&lt;startup&gt;&gt; {\n    +createApp()\n    +createPinia()\n    +restoreSession()\n  }\n\n  class HomePage &lt;&lt;boundary&gt;&gt; {\n    +displayIntroduction()\n    +displayRoute()\n    +displayFeatures()\n    +displayWelcomePanel()\n  }\n\n  class RegistrationPage &lt;&lt;boundary&gt;&gt; {\n    +displayRegistrationForm()\n    +enterUsername(username: String)\n    +enterPassword(password: String)\n    +clickCreateAccount()\n    +displayInlineError(message: String)\n    +displaySuccess()\n  }\n\n  class LoginPage &lt;&lt;boundary&gt;&gt; {\n    +displayLoginForm()\n    +enterUsername(username: String)\n    +enterPassword(password: String)\n    +clickLogin()\n    +displayInlineError(message: String)\n    +displayLoginSuccess()\n  }\n\n  class SchoolDirectoryPage &lt;&lt;boundary&gt;&gt; {\n    +sanitizeKeyword(keyword: String): String\n    +enterKeyword(keyword: String)\n    +selectTier(tier: String)\n    +selectFilters(filters: Object)\n    +selectSortOrder(sortOrder: String)\n    +displaySearchResults()\n    +displayNoResults()\n    +displayPagination()\n    +clickResetFilters()\n  }\n\n  class SchoolSummaryCard &lt;&lt;boundary&gt;&gt; {\n    +displaySchoolSummary()\n    +clickSchool()\n    +clickBookmark()\n    +displayBookmarkState()\n  }\n\n  class SchoolProfilePage &lt;&lt;boundary&gt;&gt; {\n    +displaySchoolIdentity()\n    +displayLocation()\n    +displayProgrammes()\n    +displayFees()\n    +displayFinancialSupport()\n    +displayBenchmarkHistory()\n    +clickBookmark()\n    +displayBookmarkState()\n  }\n\n  class ReviewSection &lt;&lt;boundary&gt;&gt; {\n    +displayReviews()\n    +displayReviewComposer()\n    +enterReview(content: String)\n    +displayWordCount()\n    +clickSubmitReview()\n    +clickEditReview()\n    +clickUpdateReview()\n    +clickDeleteReview()\n    +displayInlineError(message: String)\n  }\n\n  class UserProfilePage &lt;&lt;boundary&gt;&gt; {\n    +displayProfile()\n    +selectTargetEducationLevel()\n    +displayEducationFields()\n    +enterPostalCode(postalCode: String)\n    +enterAcademicScore(score: Double)\n    +clickSave()\n    +displayInlineError(message: String)\n    +displaySaveSuccess()\n  }\n\n  class BookmarkedSchoolsPage &lt;&lt;boundary&gt;&gt; {\n    +displayBookmarkedSchools()\n    +displaySchoolSummary()\n    +displayDistance()\n    +displayEntryBenchmark()\n    +displayEmptyState()\n    +clickSchool()\n    +clickSchoolDirectoryLink()\n  }\n\n  class RoadmapPage &lt;&lt;boundary&gt;&gt; {\n    +displayRuleBasedPlan()\n    +selectRankBy(option: String)\n    +setDistanceLimit(km: Integer)\n    +clickGenerateRoadmap()\n    +displayAIPlan()\n    +clickRetryAIGeneration()\n    +clickSaveRoadmap()\n    +clickEditRoadmap()\n    +modifySchoolChoices()\n    +clickSaveChanges()\n    +clickDeleteRoadmap()\n    +displayConfirmationDialog()\n    +displayError(message: String)\n  }\n\n  class AdminPanel &lt;&lt;boundary&gt;&gt; {\n    +displayAdminPanel()\n    +displayDatasetStatus()\n    +selectCsvFiles()\n    +clickUpdateDataset()\n    +disableUpdateButton()\n    +displayUpdateSuccess()\n    +displayUpdateError(message: String)\n    +clickExportDatabase()\n  }\n\n  class SchoolCatalogueStore &lt;&lt;container&gt;&gt; {\n    -schools: List&lt;SchoolInfo&gt;\n    +setSchools(list: List&lt;SchoolInfo&gt;)\n    +getSchools(): List&lt;SchoolInfo&gt;\n  }\n\n  class BookmarkListStore &lt;&lt;container&gt;&gt; {\n    -bookmarks: List&lt;Bookmark&gt;\n    +setBookmarks(list: List&lt;Bookmark&gt;)\n    +addBookmark(b: Bookmark)\n    +removeBookmark(b: Bookmark)\n  }\n\n  class AuthStore &lt;&lt;container&gt;&gt; {\n    -username: String\n    -role: Role\n    -session: TokenPair\n    +login(username: String, password: String)\n    +register(username: String, password: String)\n    +logout()\n    +restore()\n  }\n\n  class RoadmapStore &lt;&lt;container&gt;&gt; {\n    -savedRoadmap: Roadmap\n    -ruleRoadmap: List&lt;SchoolInfo&gt;\n    -aiRoadmap: List&lt;SchoolInfo&gt;\n    +setRoadmaps(rule, ai)\n    +saveRoadmap()\n    +deleteRoadmap()\n  }\n\n  class APIClient_Facade &lt;&lt;facade&gt;&gt; {\n    +sendRequest(endpoint: String, payload: Object, token: String)\n    +handleResponse(response: Object)\n    +renewTokens()\n  }\n}\n\npackage \&quot;Application Logic Layer (FastAPI)\&quot; {\n\n  class ServerStartup &lt;&lt;startup&gt;&gt; {\n    +loadEnvironmentVars()\n    +registerCORS()\n    +initializeDatabase()\n    +startBackupScheduler()\n    +mountRouters()\n  }\n\n  class AuthenticationController &lt;&lt;control&gt;&gt; {\n    +registerUser(username: String, password: String)\n    +loginUser(username: String, password: String)\n    +refreshTokens(refreshToken: String)\n    +logoutUser(refreshToken: String)\n    +validateUsername(username: String): boolean\n    +validatePassword(password: String): boolean\n    +hashPassword(password: String): String\n    +createSession(userId: int): TokenPair\n    +invalidateSession(refreshToken: String)\n    +checkLoginRateLimit(username: String, clientIp: String)\n  }\n\n  class SchoolProfileController &lt;&lt;control&gt;&gt; {\n    +getSchoolProfile(schoolKey: String)\n    +getProgrammes(schoolId: int)\n    +getFinancialSupport(schoolId: int)\n    +getBenchmarks(schoolId: int)\n  }\n\n  class SchoolDirectoryController &lt;&lt;control&gt;&gt; {\n    +listSchools(stage: String, filters: Object)\n    +getFilterOptions()\n  }\n\n  class BookmarkController &lt;&lt;control&gt;&gt; {\n    +bookmarkSchool(userId: int, schoolId: int)\n    +unbookmarkSchool(userId: int, schoolId: int)\n    +getBookmarkedSchools(userId: int)\n  }\n\n  class ReviewController &lt;&lt;control&gt;&gt; {\n    +getReviews(schoolId: int)\n    +checkExistingReview(userId: int, schoolId: int)\n    +submitReview(userId: int, schoolId: int, content: String)\n    +editReview(reviewId: int, content: String)\n    +deleteReview(reviewId: int)\n    +validateReview(content: String): boolean\n  }\n\n  class UserProfileController &lt;&lt;control&gt;&gt; {\n    +getProfile(userId: int)\n    +updateProfile(userId: int, level: String, scoreA: Double, scoreB: Double, postalCode: String)\n    +validatePostalCode(postalCode: String): boolean\n    +validateAcademicScore(score: Double, level: String): boolean\n    +locatePostalCode(postalCode: String): District\n  }\n\n  class RoadmapController &lt;&lt;control&gt;&gt; {\n    +generateRuleRoadmap(preferences: Object, transitionStage: String)\n    +generateAIRoadmap(userId: int, transitionStage: String)\n    +getSavedRoadmap(userId: int)\n    +saveRoadmap(userId: int, roadmap: Object)\n    +editRoadmap(userId: int, schoolChoices: List&lt;int&gt;)\n    +deleteRoadmap(userId: int)\n    +checkAIRateLimit(userId: int)\n  }\n\n  interface IRoadmapGenerator &lt;&lt;strategy&gt;&gt; {\n    +generatePlan(preferences: Object, transitionStage: String): Object\n  }\n\n  class RuleRoadmapGenerator &lt;&lt;control&gt;&gt; {\n    +generatePlan(preferences: Object, transitionStage: String): Object\n  }\n\n  class AIRoadmapGenerator &lt;&lt;control&gt;&gt; {\n    +generatePlan(preferences: Object, transitionStage: String): Object\n  }\n\n  class SchoolDatabaseUpdateController &lt;&lt;control&gt;&gt; {\n    +updateSchoolDatabase(files: List&lt;File&gt;)\n    +validateUpload(file: File)\n    +parseDataset(files: List&lt;File&gt;)\n    +standardizeRecords()\n    +bulkWriteRecords()\n    +commitTransaction()\n    +exportDatabase(): CSV\n  }\n}\n\npackage \&quot;Persistent Data Layer (SQLite)\&quot; {\n\n  class User &lt;&lt;entity&gt;&gt; {\n    -id: int\n    -username: String\n    -passwordHash: String\n    -role: Role\n  }\n\n  enum Role {\n    USER\n    ADMIN\n  }\n\n  class RefreshToken &lt;&lt;entity&gt;&gt; {\n    -tokenHash: String\n    -userId: int\n    -expiresAt: DateTime\n  }\n\n  class Profile &lt;&lt;entity&gt;&gt; {\n    -userId: int\n    -level: Stage\n    -scoreA: Float\n    -scoreB: Float\n    -postal: String\n    -primaryResult: String\n  }\n\n  enum Stage {\n    preschool\n    primary\n    secondary\n    postsec\n    uni\n  }\n\n  class Bookmark &lt;&lt;entity&gt;&gt; {\n    -userId: int\n    -schoolId: int\n  }\n\n  class Roadmap &lt;&lt;entity&gt;&gt; {\n    -userId: int\n    -stage: Stage\n    -source: String\n    -choices: List&lt;int&gt;\n  }\n\n  class Review &lt;&lt;entity&gt;&gt; {\n    -userId: int\n    -schoolId: int\n    -text: String\n    -createdAt: DateTime\n    -updatedAt: DateTime\n  }\n\n  class SchoolInfo &lt;&lt;entity&gt;&gt; {\n    -id: int\n    -schoolKey: String\n    -schoolName: String\n    -address: String\n    -postalCode: String\n    -latitude: Float\n    -longitude: Float\n    -schoolType: String\n    -mainlevelCode: String\n    -mrtDesc: String\n    -busDesc: String\n    -psle2017Cutoff: Integer\n  }\n\n  class SchoolBenchmark &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -year: int\n    -measure: Measure\n    -low: Float\n    -high: Float\n  }\n\n  enum Measure {\n    PSLE_AL\n    L1R5\n    ELR2B2\n    GPA\n  }\n\n  class SchoolProgramme &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -name: String\n    -field: String\n    -feeSC: Float\n    -feePR: Float\n    -feeIntl: Float\n    -miscFee: Float\n  }\n\n  class SchoolSubject &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -name: String\n  }\n\n  class SchoolCca &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -grouping: String\n    -section: String\n    -genericName: String\n    -customisedName: String\n  }\n\n  class SchoolMoeProgramme &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -name: String\n  }\n\n  class SchoolBus &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -busNo: String\n  }\n\n  class SchoolAid &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -name: String\n    -note: String\n  }\n\n  class SchoolScholarship &lt;&lt;entity&gt;&gt; {\n    -schoolId: int\n    -name: String\n    -source: String\n    -eligibility: String\n  }\n\n  class DatasetUpdate &lt;&lt;entity&gt;&gt; {\n    -createdAt: DateTime\n    -schools: int\n    -added: int\n    -updated: int\n  }\n}\n\n&#39; Presentation -&gt; Facade and containers\nHomePage ..&gt; APIClient_Facade : reads/writes\nLoginPage ..&gt; APIClient_Facade : reads/writes\nRegistrationPage ..&gt; APIClient_Facade : reads/writes\nSchoolDirectoryPage ..&gt; SchoolCatalogueStore : reads/writes\nSchoolSummaryCard ..&gt; BookmarkListStore : reads/writes\nSchoolProfilePage ..&gt; APIClient_Facade : reads/writes\nReviewSection ..&gt; APIClient_Facade : reads/writes\nUserProfilePage ..&gt; APIClient_Facade : reads/writes\nBookmarkedSchoolsPage ..&gt; BookmarkListStore : reads/writes\nRoadmapPage ..&gt; RoadmapStore : reads/writes\nAdminPanel ..&gt; APIClient_Facade : reads/writes\nClientBootstrap ..&gt; AuthStore : initializes\nClientBootstrap ..&gt; SchoolCatalogueStore : initializes\nClientBootstrap ..&gt; BookmarkListStore : initializes\nAuthStore ..&gt; APIClient_Facade : uses\nRoadmapStore ..&gt; APIClient_Facade : uses\n\n&#39; Facade -&gt; Application (HTTP)\nAPIClient_Facade ..&gt; AuthenticationController : HTTP\nAPIClient_Facade ..&gt; SchoolProfileController : HTTP\nAPIClient_Facade ..&gt; SchoolDirectoryController : HTTP\nAPIClient_Facade ..&gt; BookmarkController : HTTP\nAPIClient_Facade ..&gt; ReviewController : HTTP\nAPIClient_Facade ..&gt; UserProfileController : HTTP\nAPIClient_Facade ..&gt; RoadmapController : HTTP\nAPIClient_Facade ..&gt; SchoolDatabaseUpdateController : HTTP\n\n&#39; Startup mounts routers\nServerStartup ..&gt; AuthenticationController : mounts\nServerStartup ..&gt; SchoolProfileController : mounts\nServerStartup ..&gt; SchoolDirectoryController : mounts\nServerStartup ..&gt; BookmarkController : mounts\nServerStartup ..&gt; ReviewController : mounts\nServerStartup ..&gt; UserProfileController : mounts\nServerStartup ..&gt; RoadmapController : mounts\nServerStartup ..&gt; SchoolDatabaseUpdateController : mounts\n\n&#39; Strategy for roadmaps\nRoadmapController ..&gt; IRoadmapGenerator : uses\nIRoadmapGenerator &lt;|.. RuleRoadmapGenerator\nIRoadmapGenerator &lt;|.. AIRoadmapGenerator\n\n&#39; Control -&gt; entity\nAuthenticationController ..&gt; User\nAuthenticationController ..&gt; RefreshToken\nSchoolProfileController ..&gt; SchoolInfo\nSchoolProfileController ..&gt; SchoolProgramme\nSchoolProfileController ..&gt; SchoolBenchmark\nSchoolProfileController ..&gt; SchoolAid\nSchoolDirectoryController ..&gt; SchoolInfo\nBookmarkController ..&gt; Bookmark\nBookmarkController ..&gt; SchoolInfo\nReviewController ..&gt; Review\nReviewController ..&gt; SchoolInfo\nUserProfileController ..&gt; Profile\nRoadmapController ..&gt; Roadmap\nRuleRoadmapGenerator ..&gt; SchoolInfo\nAIRoadmapGenerator ..&gt; SchoolInfo\nSchoolDatabaseUpdateController ..&gt; SchoolInfo\nSchoolDatabaseUpdateController ..&gt; SchoolBenchmark\nSchoolDatabaseUpdateController ..&gt; DatasetUpdate\n\n&#39; Entity relationships\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; RefreshToken : issues\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Profile : has\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Roadmap : saves\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Bookmark : makes\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Review : writes\nUser --&gt; Role : role\nProfile --&gt; Stage : level\nRoadmap --&gt; Stage : stage\nSchoolBenchmark --&gt; Measure : measure\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolBenchmark\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolProgramme\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolSubject\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolCca\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolMoeProgramme\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolBus\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolAid\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolScholarship\nSchoolInfo \&quot;1\&quot; -- \&quot;0..*\&quot; Bookmark : bookmarked by\nSchoolInfo \&quot;1\&quot; -- \&quot;0..*\&quot; Review : reviewed in\nRoadmap \&quot;1\&quot; ..&gt; \&quot;0..3\&quot; SchoolInfo : choices (ids)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="g5ZbJFcmhMgKpHiCpGjx-1">
