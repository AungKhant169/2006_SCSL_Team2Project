        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml PathSG_Conceptual_Class_Diagram\nskinparam classAttributeIconSize 0\nskinparam classFontSize 11\nskinparam linetype ortho\nhide empty members\n\npackage \&quot;Boundary Classes\&quot; #FFFFE0 {\n  class HomePage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayIntroduction()\n    +displayRoute()\n    +displayFeatures()\n    +displayWelcomePanel()\n  }\n\n  class LoginPage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayAuthCard()\n    +enterUsername(username)\n    +enterPassword(password)\n    +clickLogin()\n    +clickCreateAccount()\n    +displayInlineError(message)\n  }\n\n  class DirectoryPage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displaySchools()\n    +selectTier(tier)\n    +enterKeyword(keyword)\n    +selectFilters()\n    +selectSortOrder()\n    +displayPagination()\n    +displayNoSchoolsFound()\n    +clickResetAllFilters()\n  }\n\n  class SchoolSummaryCard &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displaySchoolSummary()\n    +clickSchool()\n    +clickBookmark()\n  }\n\n  class SchoolDetailPage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displaySchoolIdentity()\n    +displayLocationMap()\n    +displayProgrammes()\n    +displayFees()\n    +displayFinancialSupport()\n    +displayBenchmarkHistory()\n  }\n\n  class ReviewSection &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayReviews()\n    +displayReviewComposer()\n    +enterReview(text)\n    +displayWordCount()\n    +clickSubmitReview()\n    +clickEditReview()\n    +clickDeleteReview()\n    +displayInlineError(message)\n  }\n\n  class ProfilePage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayProfile()\n    +selectTargetEducationLevel()\n    +enterPostalCode(postal)\n    +enterAcademicScore(score)\n    +clickSaveProfile()\n    +displayInlineError(message)\n  }\n\n  class SavedSchoolsPage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displaySavedSchools()\n    +displayDistance()\n    +displayEmptyState()\n    +clickRemove()\n  }\n\n  class RoadmapPage &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayRuleBasedPlan()\n    +displayAiPlan()\n    +selectRankBy(option)\n    +setDistanceLimit(km)\n    +clickGenerateRoadmap()\n    +clickRetryAiGeneration()\n    +clickSaveRoadmap()\n    +clickEditRoadmap()\n    +clickDeleteRoadmap()\n    +displayConfirmationDialog()\n  }\n\n  class AdminPanel &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayDatasetStatus()\n    +selectCsvFiles(files)\n    +clickUpdateDataset()\n    +clickExportDatabase()\n    +displayUpdateSuccess()\n    +displayUpdateError(message)\n  }\n\n  class NavigationHeader &lt;&lt;boundary&gt;&gt; #FFFFCC {\n    +displayMenu()\n    +clickLogin()\n    +clickLogout()\n  }\n}\n\npackage \&quot;Control Classes\&quot; #E6FFE6 {\n  class UserController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +register(username, password)\n    +login(username, password)\n    +refresh(refreshToken)\n    +logout(refreshToken)\n    +identity()\n  }\n\n  class Authenticator &lt;&lt;control&gt;&gt; #CCFFCC {\n    +getRequester(bearerToken) : User\n    +getAdminRequester(user) : User\n  }\n\n  class RateLimiter &lt;&lt;control&gt;&gt; #CCFFCC {\n    +exceeded(key) : bool\n  }\n\n  class ProfileController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +getProfile(user)\n    +saveProfile(data)\n  }\n\n  class SchoolDirectoryController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +listSchools(filters)\n    +getSchool(schoolKey)\n    +filterOptions()\n  }\n\n  class BookmarkController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +listBookmarks(user)\n    +addBookmark(schoolId)\n    +removeBookmark(schoolId)\n  }\n\n  class ReviewController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +listReviews(schoolId)\n    +submitReview(schoolId, text)\n    +editReview(reviewId, text)\n    +deleteReview(reviewId)\n  }\n\n  class RoadmapController &lt;&lt;control&gt;&gt; #CCFFCC {\n    +generateRuleRoadmap(request)\n    +generateAiRoadmap(request)\n    +getRoadmap(user)\n    +saveRoadmap(data)\n    +editRoadmap(data)\n    +deleteRoadmap(user)\n  }\n\n  class RuleRoadmapGenerator &lt;&lt;control&gt;&gt; #CCFFCC {\n    +generatePlan(preferences, stage) : List&lt;SchoolInfo&gt;\n  }\n\n  class AIRoadmapGenerator &lt;&lt;control&gt;&gt; #CCFFCC {\n    +generatePlan(preferences, stage) : List&lt;SchoolInfo&gt;\n  }\n\n  class Geolocation &lt;&lt;control&gt;&gt; #CCFFCC {\n    +validatePostal(postal)\n    +locate(postal) : District\n  }\n\n  class SchoolDatasetUpdater &lt;&lt;control&gt;&gt; #CCFFCC {\n    +refresh(uploads) : DatasetUpdate\n  }\n\n  class SchoolDatasetExporter &lt;&lt;control&gt;&gt; #CCFFCC {\n    +export() : CSV\n  }\n\n  class DatabaseBackup &lt;&lt;control&gt;&gt; #CCFFCC {\n    +runBackup()\n    +keepLast(7)\n  }\n}\n\npackage \&quot;Entity Classes\&quot; #E6F3FF {\n  class User &lt;&lt;entity&gt;&gt; #99CCFF {\n    -id : int\n    -username : String  {unique, case-insensitive}\n    -password : String  {bcrypt hash}\n    -role : Role\n  }\n\n  enum Role {\n    USER\n    ADMIN\n  }\n\n  class RefreshToken &lt;&lt;entity&gt;&gt; #99CCFF {\n    -tokenHash : String  {sha256, unique}\n    -expiresAt : DateTime  {7 days}\n  }\n\n  class Profile &lt;&lt;entity&gt;&gt; #99CCFF {\n    -userId : int  {unique}\n    -level : Stage\n    -scoreA : Float\n    -scoreB : Float\n    -postal : String(6)\n    -primaryResult : String\n  }\n\n  class Roadmap &lt;&lt;entity&gt;&gt; #99CCFF {\n    -userId : int  {unique}\n    -stage : Stage\n    -source : String  {Rule-Based Plan | AI-Generated Plan}\n    -choices : List&lt;int&gt;  {school ids, preference order, 1 to 3}\n  }\n\n  enum Stage {\n    preschool\n    primary\n    secondary\n    postsec\n    uni\n  }\n\n  class Bookmark &lt;&lt;entity&gt;&gt; #99CCFF {\n    -userId : int\n    -schoolId : int\n  }\n\n  class Review &lt;&lt;entity&gt;&gt; #99CCFF {\n    -userId : int\n    -schoolId : int\n    -text : String  {max 200 words}\n    -createdAt : DateTime\n    -updatedAt : DateTime\n  }\n\n  class SchoolInfo &lt;&lt;entity&gt;&gt; #99CCFF {\n    -id : int\n    -schoolKey : String  {unique}\n    -schoolName : String\n    -address : String\n    -postalCode : String\n    -latitude : Float\n    -longitude : Float\n    -schoolType : String\n    -mainlevelCode : String\n    -mrtDesc : String\n    -busDesc : String\n    -psle2017Cutoff : Integer\n  }\n\n  class SchoolBenchmark &lt;&lt;entity&gt;&gt; #99CCFF {\n    -year : int\n    -measure : Measure\n    -low : Float\n    -high : Float\n  }\n\n  enum Measure {\n    PSLE_AL\n    L1R5\n    ELR2B2\n    GPA\n  }\n\n  class SchoolProgramme &lt;&lt;entity&gt;&gt; #99CCFF {\n    -name : String\n    -field : String\n    -feeSC : Float\n    -feePR : Float\n    -feeIntl : Float\n    -miscFee : Float\n  }\n\n  class SchoolSubject &lt;&lt;entity&gt;&gt; #99CCFF {\n    -name : String\n  }\n\n  class SchoolCca &lt;&lt;entity&gt;&gt; #99CCFF {\n    -grouping : String\n    -section : String\n    -genericName : String\n    -customisedName : String\n  }\n\n  class SchoolMoeProgramme &lt;&lt;entity&gt;&gt; #99CCFF {\n    -name : String\n  }\n\n  class SchoolBus &lt;&lt;entity&gt;&gt; #99CCFF {\n    -busNo : String\n  }\n\n  class SchoolAid &lt;&lt;entity&gt;&gt; #99CCFF {\n    -name : String\n    -note : String\n  }\n\n  class SchoolScholarship &lt;&lt;entity&gt;&gt; #99CCFF {\n    -name : String\n    -source : String\n    -eligibility : String\n  }\n\n  class DatasetUpdate &lt;&lt;entity&gt;&gt; #99CCFF {\n    -createdAt : DateTime\n    -schools : int\n    -added : int\n    -updated : int\n  }\n}\n\n&#x27; Boundary -&gt; Control (calls)\nHomePage ..&gt; SchoolDirectoryController : &lt;&lt;call&gt;&gt;\nLoginPage ..&gt; UserController : &lt;&lt;call&gt;&gt;\nDirectoryPage ..&gt; SchoolDirectoryController : &lt;&lt;call&gt;&gt;\nSchoolSummaryCard ..&gt; BookmarkController : &lt;&lt;call&gt;&gt;\nSchoolDetailPage ..&gt; SchoolDirectoryController : &lt;&lt;call&gt;&gt;\nReviewSection ..&gt; ReviewController : &lt;&lt;call&gt;&gt;\nProfilePage ..&gt; ProfileController : &lt;&lt;call&gt;&gt;\nSavedSchoolsPage ..&gt; BookmarkController : &lt;&lt;call&gt;&gt;\nRoadmapPage ..&gt; RoadmapController : &lt;&lt;call&gt;&gt;\nAdminPanel ..&gt; SchoolDatasetUpdater : &lt;&lt;call&gt;&gt;\nAdminPanel ..&gt; SchoolDatasetExporter : &lt;&lt;call&gt;&gt;\nNavigationHeader ..&gt; UserController : &lt;&lt;call&gt;&gt;\n\n&#x27; Control internal and control -&gt; entity\nUserController ..&gt; Authenticator\nUserController ..&gt; RateLimiter : login key\nUserController ..&gt; User\nUserController ..&gt; RefreshToken\nAuthenticator ..&gt; User\nProfileController ..&gt; Profile\nProfileController ..&gt; Geolocation\nSchoolDirectoryController ..&gt; SchoolInfo\nBookmarkController ..&gt; Bookmark\nBookmarkController ..&gt; SchoolInfo\nReviewController ..&gt; Review\nReviewController ..&gt; SchoolInfo\nRoadmapController ..&gt; Roadmap\nRoadmapController ..&gt; RuleRoadmapGenerator\nRoadmapController ..&gt; AIRoadmapGenerator\nRoadmapController ..&gt; RateLimiter : AI limit\nRuleRoadmapGenerator ..&gt; SchoolInfo\nAIRoadmapGenerator ..&gt; SchoolInfo\nSchoolDatasetUpdater ..&gt; SchoolInfo\nSchoolDatasetUpdater ..&gt; SchoolBenchmark\nSchoolDatasetUpdater ..&gt; DatasetUpdate\nSchoolDatasetExporter ..&gt; SchoolInfo\nDatabaseBackup ..&gt; User : backs up data\n\n&#x27; Entity relationships\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; RefreshToken : issues\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Profile : has\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; Roadmap : saves\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Bookmark : makes\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Review : writes\nUser --&gt; Role : role\nProfile --&gt; Stage : level\nRoadmap --&gt; Stage : stage\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolBenchmark\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolProgramme\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolSubject\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolCca\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolMoeProgramme\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolBus\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolAid\nSchoolInfo \&quot;1\&quot; *-- \&quot;0..*\&quot; SchoolScholarship\nSchoolInfo \&quot;1\&quot; -- \&quot;0..*\&quot; Bookmark : bookmarked by\nSchoolInfo \&quot;1\&quot; -- \&quot;0..*\&quot; Review : reviewed in\nSchoolBenchmark --&gt; Measure : measure\nRoadmap \&quot;1\&quot; ..&gt; \&quot;0..3\&quot; SchoolInfo : choices (ids)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gw9ZXsvaeTlM6Vw69xOJ-349">
