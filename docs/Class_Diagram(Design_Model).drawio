<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="dX80QsIkQa9s2d5yza_2">
    <mxGraphModel dx="3650" dy="1893" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam class {\n    BackgroundColor White\n    ArrowColor Black\n    BorderColor #444444\n}\n\npackage \&quot;Presentation Layer (Vue SPA)\&quot; {\n\n    class ClientBootstrap &lt;&lt;startup&gt;&gt; {\n        +createApp()\n        +createPinia()\n        +restoreSession()\n    }\n\n    class SchoolCatalogueStore &lt;&lt;container&gt;&gt; {\n        -schools: List&lt;School&gt;\n        +setSchools(list: List&lt;School&gt;)\n        +getSchools(): List&lt;School&gt;\n    }\n\n    class BookmarkListStore &lt;&lt;container&gt;&gt; {\n        -bookmarks: List&lt;Bookmark&gt;\n        +setBookmarks(list: List&lt;Bookmark&gt;)\n        +addBookmark(b: Bookmark)\n        +removeBookmark(b: Bookmark)\n    }\n\n    class APIClient_Facade &lt;&lt;facade&gt;&gt; {\n        +sendRequest(endpoint, payload)\n        +handleResponse()\n    }\n\n    class RegistrationPage &lt;&lt;boundary&gt;&gt; {\n        +displayRegistrationForm()\n        +enterUsername(username: String)\n        +enterPassword(password: String)\n        +clickRegister()\n        +displayInlineError(message: String)\n        +displaySuccess()\n    }\n\n    class LoginPage &lt;&lt;boundary&gt;&gt; {\n        +displayLoginForm()\n        +enterUsername(username: String)\n        +enterPassword(password: String)\n        +clickLogin()\n        +displayInlineError(message: String)\n        +displayLoginSuccess()\n    }\n\n    class SchoolDirectoryPage &lt;&lt;boundary&gt;&gt; {\n        +displaySchools()\n        +enterKeyword(keyword: String)\n        +setFilters(filters: Object)\n        +clickSearch()\n    }\n\n    class SummaryCard &lt;&lt;boundary&gt;&gt; {\n        +displaySchoolSummary()\n        +clickSchool()\n        +clickBookmark()\n        +displayBookmarkState()\n    }\n\n    class SchoolProfilePage &lt;&lt;boundary&gt;&gt; {\n        +displaySchoolIdentity()\n        +displayLocation()\n        +displayCourses()\n        +displayFees()\n        +displayFinancialSupport()\n        +displayHistoricalStatistics()\n        +clickBookmark()\n        +displayBookmarkState()\n    }\n\n    class ReviewSection &lt;&lt;boundary&gt;&gt; {\n        +displayReviews()\n        +displayReviewTextArea()\n        +enterReview(content: String)\n        +clickSubmitReview()\n        +clickEditReview()\n        +clickUpdateReview()\n        +clickDeleteReview()\n        +displayWordCount()\n        +displayInlineError(message: String)\n    }\n\n    class UserProfilePage &lt;&lt;boundary&gt;&gt; {\n        +displayProfile()\n        +selectTargetEducationLevel()\n        +displayEducationFields()\n        +enterPostalCode(postalCode: String)\n        +enterAcademicScore(score: Double)\n        +clickSave()\n        +displayInlineError(message: String)\n        +displaySaveSuccess()\n    }\n\n    class BookmarkedSchoolsPage &lt;&lt;boundary&gt;&gt; {\n        +displayBookmarkedSchools()\n        +displaySchoolSummary()\n        +displayDistance()\n        +displayEntryBenchmark()\n        +displayEmptyState()\n        +clickSchool()\n        +clickSchoolDirectoryLink()\n    }\n\n    class RoadmapPage &lt;&lt;boundary&gt;&gt; {\n        +displayRoadmap()\n        +selectTransitionStage()\n        +clickGenerateRoadmap()\n        +displayRuleBasedPlan()\n        +displayAIPlan()\n        +clickRetryAIGeneration()\n        +clickSaveRoadmap()\n        +clickEditRoadmap()\n        +modifySchoolChoices()\n        +clickSaveChanges()\n        +clickDeleteRoadmap()\n        +displayConfirmationDialog()\n        +displayError(message: String)\n    }\n\n    class AdminPanel &lt;&lt;boundary&gt;&gt; {\n        +displayAdminPanel()\n        +clickUpdateDataset()\n        +disableUpdateButton()\n        +displayUpdateSuccess()\n        +displayUpdateError(message: String)\n    }\n\n    class SchoolDataEndpoint &lt;&lt;boundary&gt;&gt; {\n        +fetchLatestDataset()\n    }\n\n    ClientBootstrap --&gt; SchoolCatalogueStore : initializes\n    ClientBootstrap --&gt; BookmarkListStore : initializes\n    \n    SchoolDirectoryPage ..&gt; SchoolCatalogueStore : reads/writes\n    BookmarkedSchoolsPage ..&gt; BookmarkListStore : reads/writes\n    \n    RegistrationPage ..&gt; APIClient_Facade\n    LoginPage ..&gt; APIClient_Facade\n    SchoolDirectoryPage ..&gt; APIClient_Facade\n    SchoolProfilePage ..&gt; APIClient_Facade\n    ReviewSection ..&gt; APIClient_Facade\n    UserProfilePage ..&gt; APIClient_Facade\n    RoadmapPage ..&gt; APIClient_Facade\n    AdminPanel ..&gt; APIClient_Facade\n}\n\npackage \&quot;Application Logic Layer (FastAPI)\&quot; {\n\n    class ServerStartup &lt;&lt;startup&gt;&gt; {\n        +loadEnvironmentVars()\n        +registerCORS()\n        +initializeDatabase()\n        +mountRouters()\n    }\n\n    class AuthenticationController &lt;&lt;control&gt;&gt; {\n        +registerUser(username: String, password: String)\n        +loginUser(username: String, password: String)\n        +logoutUser()\n        +validateUsername(username: String): boolean\n        +validatePassword(password: String): boolean\n        +hashPassword(password: String): String\n        +createSession(userId: String)\n        +invalidateSession()\n    }\n\n    class SchoolDirectoryController &lt;&lt;control&gt;&gt; {\n        +searchSchools(keyword: String, filters: Object)\n        +filterSchools(filters: Object)\n        +sortSchools(sortOrder: String)\n        +sanitizeSearchInput(keyword: String)\n    }\n\n    class SchoolProfileController &lt;&lt;control&gt;&gt; {\n        +getSchoolProfile(schoolId: String)\n        +getCourses(schoolId: String)\n        +getFinancialSupport(schoolId: String)\n        +getHistoricalBenchmarks(schoolId: String)\n    }\n\n    class BookmarkController &lt;&lt;control&gt;&gt; {\n        +bookmarkSchool(userId: String, schoolId: String)\n        +unbookmarkSchool(userId: String, schoolId: String)\n        +getBookmarkedSchools(userId: String)\n        +calculateDistance(userPostalCode: String, schoolPostalCode: String): Double\n    }\n\n    class ReviewController &lt;&lt;control&gt;&gt; {\n        +getReviews(schoolId: String)\n        +checkExistingReview(userId: String, schoolId: String)\n        +submitReview(userId: String, schoolId: String, content: String)\n        +editReview(reviewId: String, content: String)\n        +deleteReview(reviewId: String)\n        +validateReview(content: String): boolean\n    }\n\n    class UserProfileController &lt;&lt;control&gt;&gt; {\n        +getProfile(userId: String)\n        +updateProfile(userId: String, targetEducationLevel: String, academicScore: Double, postalCode: String)\n        +validatePostalCode(postalCode: String): boolean\n        +validateAcademicScore(score: Double, level: String): boolean\n    }\n\n    class RoadmapController &lt;&lt;control&gt;&gt; {\n        +getSavedPerformances(userId: String)\n        +generateRoadmap(userId: String, transitionStage: String)\n        +saveRoadmap(userId: String, roadmap: Object)\n        +getSavedRoadmap(userId: String)\n        +updateRoadmap(roadmapId: String, schoolChoices: List)\n        +deleteRoadmap(roadmapId: String)\n    }\n\n    interface IRoadmapGenerator &lt;&lt;strategy&gt;&gt; {\n        +generatePlan(preferences, transitionStage): Object\n    }\n\n    class RuleBasedRoadmapGenerator &lt;&lt;control&gt;&gt; {\n        +generatePlan(preferences, transitionStage): Object\n    }\n\n    class AIRoadmapGenerator &lt;&lt;control&gt;&gt; {\n        +generatePlan(preferences, transitionStage): Object\n        +retryGeneration(preferences, transitionStage): Object\n    }\n\n    class SchoolDatabaseUpdateController &lt;&lt;control&gt;&gt; {\n        +updateSchoolDatabase()\n        +fetchDataset()\n        +parseDataset()\n        +standardizeRecords()\n        +bulkWriteRecords()\n        +commitTransaction()\n    }\n\n    ServerStartup --&gt; AuthenticationController : mounts\n    ServerStartup --&gt; SchoolDirectoryController : mounts\n    ServerStartup --&gt; RoadmapController : mounts\n    \n    APIClient_Facade ..&gt; AuthenticationController : HTTP\n    APIClient_Facade ..&gt; SchoolDirectoryController : HTTP\n    APIClient_Facade ..&gt; SchoolProfileController : HTTP\n    APIClient_Facade ..&gt; BookmarkController : HTTP\n    APIClient_Facade ..&gt; ReviewController : HTTP\n    APIClient_Facade ..&gt; UserProfileController : HTTP\n    APIClient_Facade ..&gt; RoadmapController : HTTP\n    APIClient_Facade ..&gt; SchoolDatabaseUpdateController : HTTP\n    \n    RoadmapController --&gt; IRoadmapGenerator : uses\n    IRoadmapGenerator &lt;|.. RuleBasedRoadmapGenerator\n    IRoadmapGenerator &lt;|.. AIRoadmapGenerator\n}\n\npackage \&quot;Persistent Data Layer (SQLite)\&quot; {\n\n    class User &lt;&lt;entity&gt;&gt; {\n        -userId: String\n        -username: String\n        -passwordHash: String\n        -passwordSalt: String\n        -role: RoleEnum\n    }\n\n    class StudentUser &lt;&lt;entity&gt;&gt; {\n        -targetEducationLevel: TargetEducationLevelEnum\n        -previousAcademicScore: Double\n        -postalCode: String\n    }\n\n    class AdminUser &lt;&lt;entity&gt;&gt; {\n    }\n\n    class School &lt;&lt;entity&gt;&gt; {\n        -schoolId: String\n        -name: String\n        -acronym: String\n        -badgeLogoUrl: String\n        -governanceType: GovernanceEnum\n        -educationalTier: EducationalTierEnum\n        -address: String\n        -postalCode: String\n        -nearestMrt: String\n        -nearestBusStop: String\n    }\n\n    class Course &lt;&lt;entity&gt;&gt; {\n        -courseId: String\n        -schoolId: String\n        -title: String\n        -fieldOfStudy: String\n        -feeSingaporeCitizen: Double\n        -feePermanentResident: Double\n        -feeInternationalStudent: Double\n    }\n\n    class HistoricalBenchmark &lt;&lt;entity&gt;&gt; {\n        -benchmarkId: String\n        -schoolId: String\n        -courseId: String\n        -year: Integer\n    }\n    \n    class SecondaryBenchmark &lt;&lt;entity&gt;&gt; {\n        -psleAlMin: Integer\n        -psleAlMax: Integer\n    }\n    \n    class JuniorCollegeBenchmark &lt;&lt;entity&gt;&gt; {\n        -jaeCutOffL1R5: Integer\n    }\n\n    class PolytechnicBenchmark &lt;&lt;entity&gt;&gt; {\n        -jaeCutOffElr2b2: Integer\n    }\n    \n    class UniversityBenchmark &lt;&lt;entity&gt;&gt; {\n        -polyGpa10thPercentile: Double\n        -polyGpa90thPercentile: Double\n        -aLevelRankPoints: Double\n    }\n\n    class FinancialSupport &lt;&lt;entity&gt;&gt; {\n        -supportId: String\n        -schoolId: String\n        -title: String\n        -description: String\n        -eligibilityCriteria: String\n    }\n\n    class FinancialAid &lt;&lt;entity&gt;&gt; {\n    }\n\n    class Scholarship &lt;&lt;entity&gt;&gt; {\n    }\n\n    class Review &lt;&lt;entity&gt;&gt; {\n        -reviewId: String\n        -userId: String\n        -schoolId: String\n        -content: String\n        -createdAt: Timestamp\n        -updatedAt: Timestamp\n    }\n\n    class Bookmark &lt;&lt;entity&gt;&gt; {\n        -bookmarkId: String\n        -userId: String\n        -schoolId: String\n        -createdAt: Timestamp\n    }\n\n    class Roadmap &lt;&lt;entity&gt;&gt; {\n        -roadmapId: String\n        -userId: String\n        -planType: PlanTypeEnum\n        -selectedSchoolIds: List&lt;String&gt;\n        -createdAt: Timestamp\n        -updatedAt: Timestamp\n    }\n\n    User &lt;|-- StudentUser\n    User &lt;|-- AdminUser\n    \n    HistoricalBenchmark &lt;|-- SecondaryBenchmark\n    HistoricalBenchmark &lt;|-- JuniorCollegeBenchmark\n    HistoricalBenchmark &lt;|-- PolytechnicBenchmark\n    HistoricalBenchmark &lt;|-- UniversityBenchmark\n    \n    FinancialSupport &lt;|-- FinancialAid\n    FinancialSupport &lt;|-- Scholarship\n\n    School \&quot;1\&quot; -- \&quot;0..*\&quot; Course\n    School \&quot;1\&quot; -- \&quot;0..*\&quot; HistoricalBenchmark\n    School \&quot;1\&quot; -- \&quot;0..*\&quot; FinancialSupport\n    School \&quot;1\&quot; -- \&quot;0..*\&quot; Review\n    \n    StudentUser \&quot;1\&quot; -- \&quot;0..*\&quot; Review\n    StudentUser \&quot;1\&quot; -- \&quot;0..*\&quot; Bookmark\n    StudentUser \&quot;1\&quot; -- \&quot;0..1\&quot; Roadmap\n    \n    Bookmark \&quot;0..*\&quot; -- \&quot;1\&quot; School\n\n    AuthenticationController ..&gt; User\n    SchoolDirectoryController ..&gt; School\n    SchoolProfileController ..&gt; School\n    SchoolProfileController ..&gt; Course\n    BookmarkController ..&gt; Bookmark\n    ReviewController ..&gt; Review\n    UserProfileController ..&gt; StudentUser\n    RoadmapController ..&gt; Roadmap\n    SchoolDatabaseUpdateController ..&gt; School\n}\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AHVdLi7uWYr5XEwliLYX-729">
