# Settings for docker-compose.yml. Copy to .env and edit.

# At least 32 characters, placeholders such as CHANGE-ME will not launch the server.
# Required. Signs login tokens; keep it secret and stable.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Origin the browser loads the site from for the API's CORS allow-list.
FRONTEND_ORIGIN=http://localhost:8080

# Port the site is published on.
HTTP_PORT=8080

# Which published images to run (a branch, release version such as 1.2.3, or sha-<commit>).
IMAGE_TAG=latest
# Registry namespace of the images. Change if you run a fork.
IMAGE_PREFIX=ghcr.io/aungkhant169/2006_scsl_team2project

# Usernames that are always admins (comma separated). Register these accounts yourself first.
ADMIN_USERNAMES=

# For AI roadmaps; without a key the endpoint answers 503.
# OPENAI_API_KEY=
# Model used for AI roadmaps (default gpt-5.5).
# OPENAI_MODEL=gpt-5.5

# Number of proxies in front of the server (default 1). 1st hop = client nginx.
# TRUSTED_PROXY_HOPS=1

# Rate limits: attempts allowed per window, in seconds.
# AI_RATE_LIMIT=10
# AI_RATE_WINDOW=300
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW=300

# Database backup: hours between copies (0 turns it off), and how many copies to keep.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
