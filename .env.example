# Settings for docker-compose.yml. Copy to .env and edit.

# At least 32 characters, placeholders such as CHANGE-ME will not launch the server.
# Required. Signs login tokens; keep it secret and stable.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Public address of the site, used for the API's CORS allow-list.
PUBLIC_ORIGIN=http://localhost:8080

# Port the site is published on.
HTTP_PORT=8080

# Which published images to run (a branch, release version such as 1.2.3, or sha-<commit>).
IMAGE_TAG=latest
# Registry namespace of the images. Change if you run a fork.
IMAGE_PREFIX=ghcr.io/aungkhant169/2006_scsl_team2project

# Usernames that are always admins (comma separated). Register these accounts yourself first.
ADMIN_USERNAMES=

# Needed for AI roadmaps. Without a key the AI plan reports that it is unavailable.
OPENAI_API_KEY=
# Model used for AI roadmaps (default gpt-5.5).
# OPENAI_MODEL=gpt-5.5
