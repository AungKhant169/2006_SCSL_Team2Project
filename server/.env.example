# Default to SQLite file located at "REPO/server/main.db".
DATABASE_URL="sqlite:///./main.db"

# At least 32 characters, placeholders such as CHANGE-ME will not launch the server.
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME

FRONTEND_ORIGIN=http://localhost:8080

# Comma-separated usernames that are always admins. Register these accounts yourself first.
ADMIN_USERNAMES=

# Largest CSV an admin may upload, in MB (default 20).
# SCHOOL_MAX_UPLOAD_MB=20

# Needed for AI roadmaps (POST /roadmap/generate-ai-roadmap). Without it that endpoint returns 503.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
