# Default to SQLite file located at "REPO/server/main.db".
DATABASE_URL="sqlite:///./main.db"

# At least 32 characters, placeholders such as CHANGE-ME will not launch the server.
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME

# Origin the browser loads the site from for the API's CORS allow-list.
FRONTEND_ORIGIN=http://localhost:8080

# Usernames (comma separated) that may run the school data update through the older
# POST /school-api/admin/refresh route. This does NOT give the Admin panel or the /admin/* routes:
# for those, give the account the admin role with `python -m scripts.make_admin <username>`.
ADMIN_USERNAMES=

# Largest CSV an admin may upload, in MB (default 20).
# SCHOOL_MAX_UPLOAD_MB=20

# Daily backup of the SQLite database: hours between copies (default 24, 0 turns it off), how
# many copies to keep (default 7), and where to put them (default: a "backups" folder next to
# the database file).
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_DIR=

# For AI roadmaps; without a key the endpoint answers 503.
# OPENAI_API_KEY=
# Model used for AI roadmaps (default gpt-5.5).
# OPENAI_MODEL=gpt-5.5
